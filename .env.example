# ========== 数据库 / 队列（scripts/infra-up.mjs 起的本地服务）==========
# Postgres = PGlite socket 线协议服务（127.0.0.1:5432 生产同协议换 Docker）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Redis = Windows 原生二进制（127.0.0.1:6379）
REDIS_URL=redis://127.0.0.1:6379

# ========== LLM Provider 密钥（网关按 ModelProvider.apiKeyEnv 引用这里的名字）==========
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# ========== 应用 ==========
API_PORT=3002
# mock 工单系统（G 任务）
MOCK_RPA_PORT=3003
# P4 起
JWT_SECRET=
# P0-P3 网关管理端的简单保护（可空=不启用）
INTERNAL_API_KEY=
